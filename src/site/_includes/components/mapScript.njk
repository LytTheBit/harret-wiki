<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
  .leaflet-map-container {
    background: #e8dcc0;
  }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function () {
  // --- Configurazione letta dal frontmatter della nota (vedi esempio) ---
  var IMAGE_WIDTH = {{ mapWidth }};
  var IMAGE_HEIGHT = {{ mapHeight }};
  var LAYERS = {
    {% for layer in mapLayers %}
    "{{ layer.label }}": "{{ layer.url }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  };

  var DEFAULT_MARKER_COLOR = "#c9302c";
  var DEFAULT_REGION_COLOR = "#a8854f";
  var DEFAULT_REGION_FILL = "#c9a227";

  function pinIcon(color) {
    var svg = ''
      + '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="38" viewBox="0 0 26 38">'
      + '<path d="M13 0C5.8 0 0 5.8 0 13c0 9.5 13 25 13 25s13-15.5 13-25C26 5.8 20.2 0 13 0z" fill="' + color + '" stroke="#fff" stroke-width="1.5"/>'
      + '<circle cx="13" cy="13" r="5" fill="#fff"/>'
      + '</svg>';
    return L.divIcon({
      html: svg, className: '', iconSize: [26, 38], iconAnchor: [13, 38], popupAnchor: [0, -34]
    });
  }

  function initMap() {
    var container = document.getElementById("map-canvas");
    if (!container) return;
    container.classList.add("leaflet-map-container");

    var bounds = [[0, 0], [IMAGE_HEIGHT, IMAGE_WIDTH]];
    var map = L.map(container, { crs: L.CRS.Simple });

    var overlays = {};
    var first = true;
    Object.keys(LAYERS).forEach(function (label) {
      var layer = L.imageOverlay(LAYERS[label], bounds);
      overlays[label] = layer;
      if (first) { layer.addTo(map); first = false; }
    });
    map.fitBounds(bounds);

    var fitZoom = map.getBoundsZoom(bounds);
    map.setMinZoom(fitZoom);
    map.setMaxZoom(fitZoom + 5);

    var pad = Math.max(IMAGE_WIDTH, IMAGE_HEIGHT) * 0.15;
    map.setMaxBounds([[-pad, -pad], [IMAGE_HEIGHT + pad, IMAGE_WIDTH + pad]]);

    if (Object.keys(overlays).length > 1) {
      L.control.layers(overlays, {}, { collapsed: false }).addTo(map);
    }

    // --- Dati marker/regioni: letti dal blocco <script type="application/json">
    // presente nel corpo della STESSA nota (nessun file esterno da tenere sincronizzato) ---
    var dataEl = document.getElementById("map-data");
    var mapData = { markers: [], regions: [] };
    if (dataEl) {
      try { mapData = JSON.parse(dataEl.textContent); }
      catch (err) { console.warn("JSON della mappa non valido:", err); }
    }

    (mapData.markers || []).forEach(function (m) {
      var latlng = [IMAGE_HEIGHT - m.y, m.x];
      var popupHtml = "<strong>" + m.name + "</strong>";
      if (m.link) popupHtml += '<br><a href="' + m.link + '">apri la nota</a>';
      if (m.note) popupHtml += '<br><span style="font-size:12px;">' + m.note + "</span>";
      var color = m.color || DEFAULT_MARKER_COLOR;
      L.marker(latlng, { icon: pinIcon(color) }).addTo(map).bindPopup(popupHtml);
    });

    (mapData.regions || []).forEach(function (reg) {
      var latlngs = reg.points.map(function (p) { return [IMAGE_HEIGHT - p.y, p.x]; });
      var popupHtml = "<strong>" + reg.name + "</strong>";
      if (reg.link) popupHtml += '<br><a href="' + reg.link + '">apri la nota</a>';
      if (reg.note) popupHtml += '<br><span style="font-size:12px;">' + reg.note + "</span>";
      var borderColor = reg.color || DEFAULT_REGION_COLOR;
      var fillColor = reg.fillColor || reg.color || DEFAULT_REGION_FILL;
      var poly = L.polygon(latlngs, { color: borderColor, weight: 2, fillColor: fillColor, fillOpacity: 0.15 })
        .addTo(map).bindPopup(popupHtml);
      poly.on("mouseover", function () { this.setStyle({ fillOpacity: 0.35 }); });
      poly.on("mouseout", function () { this.setStyle({ fillOpacity: 0.15 }); });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMap);
  } else {
    initMap();
  }
})();
</script>
